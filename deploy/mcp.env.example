# Copy to deploy/mcp.env (chmod 600). No credential goes here: the server refuses to
# start if CARPE_API_KEY, CARPE_X402_*, CARPE_MCP_AUTH_TOKEN or CARPE_OUTPUT_DIR is set.

# Authorization server (iss of every access token) and this server's resource URL
# (required in the token aud). They must match the operator's OIDC_ISSUER and
# MCP_OAUTH_RESOURCE byte for byte.
CARPE_OAUTH_ISSUER=https://compte.carpe-diem.xyz
CARPE_MCP_PUBLIC_URL=https://mcp.carpe-diem.xyz

# Key of the hashed user id in the logs: set it (32+ random bytes, e.g.
# `openssl rand -hex 32`) so log lines stay correlatable across restarts.
CARPE_MCP_LOG_SALT=

# Browser origins allowed to call /mcp (requests without Origin, like ChatGPT's and
# claude.ai's servers, are not affected). Empty = every browser origin refused.
CARPE_MCP_ALLOWED_ORIGINS=

# Optional limits (defaults shown). The three memory budgets (sessions, request bodies,
# media store) are what compose.yml's mem_limit is sized for: raise it with them.
# CARPE_MCP_RATE_PER_MIN=120
# CARPE_MCP_RATE_BURST=30
# CARPE_MCP_MAX_INFLIGHT_PER_USER=4
# CARPE_MCP_MAX_SESSIONS_PER_USER=5
# CARPE_MCP_MAX_SESSIONS=200
# CARPE_MCP_BODY_BUDGET_MB=64
# CARPE_MCP_BODY_BUDGET_PER_USER_MB=48
# CARPE_MCP_BODY_TIMEOUT_S=30
# CARPE_MCP_MAX_JSON_VALUES=100000
# Temporary media store (outputs too large to return inline, served at /media/<id> for one hour).
# CARPE_MCP_MEDIA_STORE_MB=256
# CARPE_MCP_MEDIA_STORE_PER_USER_MB=128
# CARPE_MAX_PER_CALL_USD=0.5
